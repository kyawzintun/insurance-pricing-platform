# Optional: copy to .env to override Compose defaults.
# Public, development-only credentials. Never use these outside local learning.
POSTGRES_USER=insurance_dev
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=15432
KAFKA_EXTERNAL_PORT=29092

# Host-running Spring Boot applications (export these into the shell before Maven).
POSTGRES_HOST=localhost
# If omitted, applications derive localhost:<KAFKA_EXTERNAL_PORT> automatically.
# Set this explicitly for other broker hosts or multiple bootstrap servers.
# KAFKA_BOOTSTRAP_SERVERS=localhost:29092

API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
QUOTE_SERVICE_PORT=8082
PRICING_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
AUDIT_SERVICE_PORT=8085

# Auth, Gateway, Quote, and Pricing: use the same optional local override; local YAML provides a public learning-only key.
# Required outside local profile: Base64 encoding of at least 32 random bytes.
# AUTH_JWT_SECRET=
AUTH_JWT_ACCESS_TOKEN_TTL=15m
AUTH_JWT_ISSUER=insurance-auth-service

# Gateway routing and future Angular origin (optional overrides).
AUTH_SERVICE_URL=http://localhost:8081
QUOTE_SERVICE_URL=http://localhost:8082
# Used by Gateway for admin routing and Quote for direct internal calculation.
PRICING_SERVICE_URL=http://localhost:8083
# Quote synchronous HTTP client timeouts.
PRICING_CONNECT_TIMEOUT=2s
PRICING_READ_TIMEOUT=5s
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Quote expiration: fixed delay in milliseconds; one bounded transaction per poll.
QUOTE_EXPIRATION_ENABLED=true
QUOTE_EXPIRATION_POLL_INTERVAL=60000
QUOTE_EXPIRATION_BATCH_SIZE=50

# Phase 25: supply only to Auth and Quote; replace placeholder externally.
QUOTE_SERVICE_CLIENT_ID=quote-service
QUOTE_SERVICE_CLIENT_SECRET=<external-secret>
SERVICE_TOKEN_TTL=5m
SERVICE_TOKEN_URL=http://localhost:8081/api/v1/auth/service-token
SERVICE_TOKEN_EXPIRY_MARGIN=30s

# Phase 26: bounded HTTP waits (Spring duration values)
AUTH_TOKEN_CONNECT_TIMEOUT=2s
AUTH_TOKEN_READ_TIMEOUT=5s
PRICING_CB_FAILURE_RATE_THRESHOLD=50
PRICING_CB_MIN_CALLS=5
PRICING_CB_SLIDING_WINDOW_SIZE=10
PRICING_CB_OPEN_WAIT=10s
# Gateway connect uses milliseconds; response uses a duration.
GATEWAY_HTTP_CONNECT_TIMEOUT_MS=2000
GATEWAY_HTTP_RESPONSE_TIMEOUT=30s
